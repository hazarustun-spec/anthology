    "The notes app your AI writes into. Say it in Claude, find it here, on your Mac and iPhone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zekânın içine yazdığı not uygulaması. Claude'a söyle, burada bul; Mac'inde ve iPhone'unda."
          }
        }
      }
    },
    "add SQL to my skills": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SQL'i skill listeme ekle"
          }
