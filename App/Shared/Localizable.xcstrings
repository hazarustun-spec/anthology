        }
      }
    },
    "Start a message with your shortcut and Claude files it into the right note, without asking.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajına kısayolunla başla; Claude sormadan doğru nota yerleştirsin."
          }
        }
      }
    },
    "Connect your AI": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zekânı bağla"
          }
        }
      }
    },
    "One click. Margin adds itself to Claude; Gemini CLI, Cursor, VS Code and Codex are in Settings.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek tık. Margin kendini Claude'a ekler; Gemini CLI, Cursor, VS Code ve Codex Ayarlar'da."
          }
        }
      }
    },
    "Make the shortcuts yours": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayolları kendine göre ayarla"
          }
        }
      }
    },
    "Change them any time in Settings › Shortcuts.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğin zaman Ayarlar › Kısayollar'dan değiştirebilirsin."
          }
        }
      }
    },
    "Saved word for word, never sent to Claude": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
