          "stringUnit": {
            "state": "translated",
            "value": "Arka plan"
          }
        }
      }
    },
    "Notify when an AI tool changes a note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yapay zekâ aracı notu değiştirince bildir"
          }
        }
      }
    },
    "Open Margin at login": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açılınca Margin'i başlat"
          }
        }
      }
    },
    "Notifications are silent. Margin keeps running in the menu bar after you close its window, so it can tell you about changes.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler sessizdir. Penceresini kapatsan da Margin menü çubuğunda çalışmaya devam eder; böylece değişiklikleri sana haber verebilir."
          }
        }
      }
    },
    "Claude": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude"
          }
        }
      }
    },
    "Other AI tools": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer yapay zekâ araçları"
          }
        }
      }
