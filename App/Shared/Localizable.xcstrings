    "You're all set": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey hazır"
          }
        }
      }
    },
    "Your notes are plain Markdown files on your Mac. Every AI change can be undone, and you can lock Margin with Touch ID in Settings.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notların Mac'inde düz Markdown dosyaları olarak durur. Yapay zekânın her değişikliği geri alınabilir; Ayarlar'dan Margin'i Touch ID ile kilitleyebilirsin."
          }
        }
      }
    },
