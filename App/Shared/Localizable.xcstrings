    "Allow AI tools to move notes between topics": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zekâ araçları notları konular arasında taşıyabilsin"
          }
        }
      }
    },
    "Allow AI tools to delete notes": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zekâ araçları not silebilsin"
          }
        }
      }
    },
    "What AI tools may do": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zekâ araçlarının izinleri"
          }
        }
      }
    },
    "Every AI change is kept in the note's history and can be undone. Deleting is off by default, so a tool tricked by a web page can't remove your notes.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zekânın yaptığı her değişiklik notun geçmişinde saklanır ve geri alınabilir. Silme varsayılan olarak kapalıdır; bir web sayfasıyla kandırılmış bir araç notlarını silemez."
          }
        }
      }
    },
    "Keyboard": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye"
          }
        }
