      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen"
          }
        }
      }
    },
    "Claude updated this note while you were typing.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen yazarken Claude bu notu güncelledi."
          }
        }
      }
    },
    "Show Claude's version": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
