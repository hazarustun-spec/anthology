    "No notes yet": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz not yok"
          }
        }
      }
    },
    "Notes Claude saves from this folder appear here.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude'un bu klasörden kaydettiği notlar burada görünür."
          }
        }
      }
    },
    "No note selected": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Not seçilmedi"
          }
        }
      }
    },
    "Pick a note, or ask Claude to save something to Margin.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir not seç ya da Claude'a Margin'e bir şey kaydetmesini söyle."
          }
        }
      }
    },
    "Move to Trash": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp Sepetine Taşı"
          }
        }
      }
    },
