      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop ve Cowork"
          }
        }
      }
    },
    "Claude restarts once to load Margin": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Margin'i yüklemek için Claude bir kez yeniden başlar"
          }
        }
      }
    },
    "Then just say \"save this to Margin\" in any conversation.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonra herhangi bir sohbette \"bunu Margin'e kaydet\" demen yeterli."
          }
        }
      }
    },
